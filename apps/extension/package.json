    "test": "vitest run"
  },
  "dependencies": {
    "@taskflow/bug-capture": "workspace:*",
    "@taskflow/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
