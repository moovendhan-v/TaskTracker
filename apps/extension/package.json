{
  "name": "@taskflow/extension",
  "version": "0.1.0",
  "private": true,
  "description": "TaskFlow bug reporter for Chrome and Firefox (Manifest V3): screenshot, annotate, record, and file with console and network diagnostics.",
  "license": "MIT",
  "type": "module",
  "scripts": {
