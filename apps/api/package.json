{
  "name": "@taskflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && vitest run -c vitest.e2e.config.ts",
    "migration:run": "pnpm build && node --env-file-if-exists=../../.env dist/cli/run-migrations.js",
    "admin:promote": "pnpm build && node --env-file-if-exists=../../.env dist/cli/promote-super-admin.js",
    "graphql:export": "pnpm build && node dist/cli/export-graphql-schema.js ../../packages/sdk/schema.graphql",
    "seed": "pnpm build && node --env-file-if-exists=../../.env dist/cli/seed-demo.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1162.0",
    "@better-auth/passkey": "1.7.18",
    "@better-auth/sso": "1.7.18",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@taskflow/shared-types": "workspace:*",
    "better-auth": "1.7.18",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "17.1.0",
    "graphql-query-complexity": "2.0.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "lib0": "0.2.119",
    "livekit-server-sdk": "2.19.2",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.3",
    "@taskflow/sdk": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/ws": "8.18.2",
    "graphql-ws": "6.4.1",
    "jose": "6.2.3",
    "smtp-server": "3.21.3",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
