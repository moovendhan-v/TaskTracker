# Copy to .env and fill in. Names only here; never commit real values.

# ── API (local `pnpm dev:api`) ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Runtime role the API connects as (data only, subject to row-level security)
DATABASE_URL=postgres://taskflow_app:<password>@localhost:5432/taskflow
# Schema owner used by `pnpm --filter @taskflow/api migration:run`. Optional: falls back to DATABASE_URL
MIGRATION_DATABASE_URL=postgres://taskflow_owner:<password>@localhost:5432/taskflow
DATABASE_SSL=false
# At least 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# Origin the browser uses. In dev the Vite server proxies /api, so this is the Vite origin.
BETTER_AUTH_URL=http://localhost:5173
# Comma-separated allowlist of browser origins (CORS and Better Auth's CSRF origin check)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 when none)
TRUST_PROXY=0
# Cloudflare Turnstile secret; when set, sign-up, sign-in and password reset need a CAPTCHA token.
# Required when NODE_ENV=production. Cloudflare publishes always-pass test keys for local use.
TURNSTILE_SECRET_KEY=

# Outgoing mail for password resets (smtp:// or smtps://). Required when NODE_ENV=production.
# In development, leave empty and reset links are printed to the API log.
SMTP_URL=
MAIL_FROM=
# Shared cache (redis:// or rediss://). Required when NODE_ENV=production; empty means an in-process cache.
REDIS_URL=

# File uploads (chat attachments): `local` (disk; development only) or `s3`.
# `s3` works with AWS S3, Cloudflare R2 and MinIO. Required when NODE_ENV=production.
# The bucket stays private: the API streams files in and out through short-lived signed links.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_BUCKET=
S3_REGION=us-east-1
# S3-compatible services only, e.g. http://localhost:9000 (MinIO) or https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# true for MinIO
S3_FORCE_PATH_STYLE=false
# Leave both empty to use the AWS default credential chain (e.g. an instance role).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Automation scheduler: seconds between checks for waiting runs and due-soon / overdue triggers.
# 0 turns it off in this process (run it in at least one API instance; several are safe).
AUTOMATION_TICK_SECONDS=60
# How often (seconds) old chat is removed in workspaces that set a retention period; 0 turns it off
CHAT_RETENTION_SWEEP_SECONDS=3600
# Hosts the automation "Call a webhook" step may call, comma-separated (e.g. hooks.slack.com,*.example.com).
# Empty turns webhook steps off. Calls are https only and never reach private addresses.
AUTOMATION_WEBHOOK_HOSTS=

# ── Web ────────────────────────────────────────────────────────────────────
# Public site key for the Turnstile widget (leave empty to turn the CAPTCHA off)
VITE_TURNSTILE_SITE_KEY=

# ── Docker compose stack (`pnpm infra:up`) ────────────────────────────────
# Superuser, used only by the database init script
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=taskflow
# Schema owner, used only by the migrate job
APP_DB_OWNER=taskflow_owner
APP_DB_OWNER_PASSWORD=
# Least-privilege role the API connects as (data only)
APP_DB_USER=taskflow_app
APP_DB_PASSWORD=
# Where the browser reaches the stack
PUBLIC_URL=http://localhost:8080
WEB_HOST_PORT=8080
# Local Mailpit inbox for the Docker stack's emails
MAILPIT_UI_PORT=8025
POSTGRES_HOST_PORT=5432
# Password for the stack's Redis cache
REDIS_PASSWORD=
# MinIO (S3-compatible) for the stack's uploads. The bucket is created private on start.
MINIO_ROOT_USER=taskflow
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=taskflow-uploads
MINIO_CONSOLE_PORT=9001

# ── Dev stack (`./scripts/dev.sh`, infra/docker/docker-compose.dev.yml) ───
# Ports on localhost. ./scripts/dev.sh moves to the next free port when one is taken.
DEV_WEB_PORT=5180
DEV_API_PORT=3100
DEV_POSTGRES_PORT=55432
DEV_MAIL_PORT=8125
DEV_MINIO_CONSOLE_PORT=9101
# Seed the demo workspace on start (skipped when it already exists)
SEED_DEMO=true
# Password for the demo accounts (avery@, jordan@, sam@, kai@example.com); at least 10 characters
SEED_PASSWORD=
