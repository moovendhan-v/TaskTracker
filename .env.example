# Copy to .env and fill in. Names only here; never commit real values.

# API
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://taskflow:<password>@localhost:5432/taskflow
DATABASE_SSL=false
# At least 32 random characters, e.g. `openssl rand -base64 48`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 when none)
TRUST_PROXY=0
# Cloudflare Turnstile secret; when set, sign-up, sign-in and password reset require a CAPTCHA token
TURNSTILE_SECRET_KEY=

# Web
VITE_API_URL=http://localhost:3000
VITE_TURNSTILE_SITE_KEY=

# Local infra (docker compose / terraform)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=
POSTGRES_DB=taskflow
