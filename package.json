{
  "name": "taskflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "test:e2e": "pnpm --filter @taskflow/api test:e2e && pnpm --filter @taskflow/web test:e2e",
    "dev:api": "pnpm --filter @taskflow/api dev",
    "dev:web": "pnpm --filter @taskflow/web dev",
    "sdk:generate": "pnpm --filter @taskflow/shared-types build && pnpm --filter @taskflow/api graphql:export && pnpm --filter @taskflow/sdk generate && pnpm --filter @taskflow/sdk build",
    "db:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d postgres",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d --build",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down",
    "dev:stack": "./scripts/dev.sh",
    "dev:stack:down": "./scripts/dev.sh down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
