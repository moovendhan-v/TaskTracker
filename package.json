{
  "name": "taskflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @taskflow/api dev",
    "dev:web": "pnpm --filter @taskflow/web dev",
    "sdk:generate": "pnpm --filter @taskflow/shared-types build && pnpm --filter @taskflow/api graphql:export && pnpm --filter @taskflow/sdk generate && pnpm --filter @taskflow/sdk build",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml --env-file .env up -d --build",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml --env-file .env down"
  }
}
