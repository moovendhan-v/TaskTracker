# Copy to terraform.tfvars (git-ignored) and fill in. Never commit real values.
postgres_password     = ""
app_db_owner_password = ""
app_db_password       = ""
better_auth_secret    = ""
redis_password        = ""

# Optional
# public_url           = "http://localhost:8080"
# web_host_port        = 8080
